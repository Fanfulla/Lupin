{
  "name": "lupin-code",
  "version": "0.3.1",
  "description": "Local proxy: use Claude Code (MCP, skills, hooks, plugins) with any LLM provider",
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "proxy",
    "router",
    "llm",
    "openai",
    "chatgpt",
    "gemini",
    "code-assist",
    "kimi",
    "deepseek",
    "oauth",
    "ollama",
    "lm-studio",
    "openrouter",
    "cli",
    "github-copilot",
    "copilot",
    "claude-code-router",
    "llm-proxy",
    "subscription",
    "moonshot",
    "glm",
    "zai",
    "agent",
    "mcp"
  ],
  "homepage": "https://github.com/Fanfulla/Lupin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fanfulla/Lupin.git"
  },
  "bugs": {
    "url": "https://github.com/Fanfulla/Lupin/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "lupin": "dist/cli.js"
  },
  "files": [
    "dist",
    "fixtures/mcp-echo",
    "examples",
    "tui/src",
    "tui/Cargo.toml",
    "tui/Cargo.lock",
    "tui/build-msvc.bat",
    "tui/README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "start": "tsx src/server/start.ts",
    "lupin": "tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.10",
    "hono": "^4.12.30",
    "js-tiktoken": "^1.0.21",
    "undici": "^7.28.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  }
}
