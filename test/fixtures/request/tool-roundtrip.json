{
  "name": "tool-roundtrip",
  "spec": "SPEC-TRANSLATION §2 rules 1-3 and 6-8, §10 cases 2 and 4",
  "direction": "request",
  "quirks": [],
  "input": {
    "model": "test-model",
    "max_tokens": 2048,
    "messages": [
      { "role": "user", "content": "Leggi a.txt e scrivi b.txt" },
      {
        "role": "assistant",
        "content": [
          { "type": "thinking", "thinking": "ragionamento da droppare" },
          { "type": "text", "text": "Leggo il file." },
          { "type": "tool_use", "id": "toolu_01", "name": "read_file", "input": { "path": "a.txt" } }
        ]
      },
      {
        "role": "user",
        "content": [
          { "type": "tool_result", "tool_use_id": "toolu_01", "content": "contenuto del file" },
          { "type": "text", "text": "ok continua" }
        ]
      },
      {
        "role": "assistant",
        "content": [
          { "type": "tool_use", "id": "toolu_02", "name": "write_file", "input": { "path": "b.txt", "text": "x" } }
        ]
      },
      {
        "role": "user",
        "content": [
          {
            "type": "tool_result",
            "tool_use_id": "toolu_02",
            "is_error": true,
            "content": [{ "type": "text", "text": "permesso negato" }]
          }
        ]
      }
    ]
  },
  "expected": {
    "model": "test-model",
    "messages": [
      { "role": "user", "content": "Leggi a.txt e scrivi b.txt" },
      {
        "role": "assistant",
        "content": "Leggo il file.",
        "tool_calls": [
          { "id": "toolu_01", "type": "function", "function": { "name": "read_file", "arguments": "{\"path\":\"a.txt\"}" } }
        ]
      },
      { "role": "tool", "tool_call_id": "toolu_01", "content": "contenuto del file" },
      { "role": "user", "content": "ok continua" },
      {
        "role": "assistant",
        "content": null,
        "tool_calls": [
          {
            "id": "toolu_02",
            "type": "function",
            "function": { "name": "write_file", "arguments": "{\"path\":\"b.txt\",\"text\":\"x\"}" }
          }
        ]
      },
      { "role": "tool", "tool_call_id": "toolu_02", "content": "Error: permesso negato" }
    ],
    "max_tokens": 2048,
    "n": 1
  }
}
